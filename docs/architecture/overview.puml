@startuml
title Cryptnox SDK Arduino - Layered architecture

package "Cryptnox SDK Cpp" <<Frame>> {
package "Library" {
    class CryptnoxWallet {
        + CryptnoxWallet(driver, logger)
        + begin() : bool
        + connect(session) : bool
        + disconnect(session) : void
        + getCardInfo(session) : void
        + verifyPin(session) : void
        --
        - driver : CW_NfcTransport&
        - logger : CW_Logger&
        - secure : CW_SecureChannel
        --
        - isSecureChannelOpen(session) : bool
    }
}

package "Secure stack" {
    class CW_SecureChannel {
        + selectApdu(driver, logger) : bool
        + getCardCertificate(driver, logger, ...) : bool
        + extractCardEphemeralKey(cert, pubKey) : bool
        + openSecureChannel(session, driver, logger, ...) : bool
        + mutuallyAuthenticate(session, driver, logger, ...) : bool
        + aesCbcEncrypt(session, driver, logger, ...) : void
        + aesCbcDecrypt(session, ...) : bool
        + checkStatusWord(...) : bool
        + printApdu(logger, apdu, length, label) : void
        --
        - crypto : CW_CryptoProvider
    }

    class CW_SecureSession {
        + aesKey[CW_AESKEY_SIZE] : uint8_t
        + macKey[CW_MACKEY_SIZE] : uint8_t
        + iv[CW_IV_SIZE] : uint8_t
        --
        + CW_SecureSession()
        + clear() : void
    }
}

package "Crypto abstraction" {
    abstract class CW_CryptoProvider {
        + sha512(data, len, out) : bool
        + aesCbcEncrypt(key, iv, data, len, out) : bool
        + aesCbcDecrypt(key, iv, data, len, out) : bool
        + ecdh(pubKey, privKey, secret) : bool
        + random(out, len) : bool
        + generateKeyPair(pubKey, privKey, curve) : bool
    }

    class ArduinoCryptoProvider {
        + sha512(data, len, out) : bool
        + aesCbcEncrypt(key, iv, data, len, out) : bool
        + aesCbcDecrypt(key, iv, data, len, out) : bool
        + ecdh(pubKey, privKey, secret) : bool
        + random(out, len) : bool
        + generateKeyPair(pubKey, privKey, curve) : bool
        --
        - aes : AESLib
        - sha : SHA512
    }
}

package "Transport" {
    abstract class CW_NfcTransport {
        + begin() : bool
        + inListPassiveTarget() : bool
        + sendAPDU(apdu, apduLen, response, responseLen) : bool
        + resetReader() : void
        + printFirmwareVersion() : bool
    }

    class PN532Adapter {
        + begin() : bool
        + inListPassiveTarget() : bool
        + sendAPDU(apdu, apduLen, response, responseLen) : bool
        + resetReader() : void
        + printFirmwareVersion() : bool
        --
        - nfc : Adafruit_PN532*
    }
}

package "Logging" {
    abstract class CW_Logger {
        + begin(baudRate) : bool
        + print(...) : void
        + println(...) : void
    }

    class ArduinoLoggerAdapter {
        + ArduinoLoggerAdapter(serial)
        + begin(baudRate) : bool
        + print(...) : void
        + println(...) : void
        --
        - serial : HardwareSerial*
    }
}
}

package "External Libraries" <<Frame>> #FFFDE7 {
    
    class Adafruit_PN532 <<library>> {
        + begin() : void
        + inDataExchange() : bool
        + readPassiveTargetID() : bool
        + SAMConfig() : void
        + getFirmwareVersion() : uint32_t
    }
    
    class AESLib <<library>> {
        + set_paddingmode(mode) : void
        + encrypt(input, len, output, key, keyLen, iv) : uint16_t
        + decrypt(input, len, output, key, keyLen, iv) : uint16_t
    }
    
    class "uECC (micro-ecc)" as uECC <<library>> {
        + uECC_secp256r1() : uECC_Curve_t
        + uECC_make_key(pubKey, privKey, curve) : bool
        + uECC_shared_secret(pubKey, privKey, secret, curve) : int
        + uECC_set_rng(rng_callback) : void
    }

    class SHA512 <<library>> {
        + update(data, len) : void
        + finalize(output, len) : void
    }

    class HardwareSerial <<Arduino>> {
        + begin(baudRate) : void
        + print(...) : size_t
        + println(...) : size_t
    }
}

' ==============================
' Relations principales
' ==============================

CryptnoxWallet --> CW_SecureChannel
CryptnoxWallet ..> CW_Logger
CryptnoxWallet ..> CW_NfcTransport
CW_SecureChannel *.. CW_SecureSession
CW_SecureChannel ..> CW_CryptoProvider
CW_SecureChannel ..> CW_NfcTransport
CW_SecureChannel ..> CW_Logger

CW_CryptoProvider <|.. ArduinoCryptoProvider
CW_NfcTransport <|.. PN532Adapter
CW_Logger <|.. ArduinoLoggerAdapter

ArduinoLoggerAdapter ..> HardwareSerial

ArduinoCryptoProvider *.. AESLib
ArduinoCryptoProvider ..> uECC
ArduinoCryptoProvider *.. SHA512
PN532Adapter ..> Adafruit_PN532

@enduml
